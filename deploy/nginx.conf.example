# Include from Nginx's http context. Replace the hostname and certificate paths
# after provisioning the VPS. Create /etc/nginx/stemroom.htpasswd on the server.
map $http_upgrade $stemroom_connection {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name stemroom.tylergriffith.us;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name stemroom.tylergriffith.us;
    ssl_certificate /etc/letsencrypt/live/stemroom.tylergriffith.us/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stemroom.tylergriffith.us/privkey.pem;
    auth_basic "Stemroom private room";
    auth_basic_user_file /etc/nginx/stemroom.htpasswd;
    client_max_body_size 500m;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $stemroom_connection;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "private, no-store" always;
    }
}
